/**
 * Demultiplexor:
 * {a, b} = {in, 0} if sel == 0
 *          {0, in} if sel == 1
 */

CHIP DMux {
    IN in, sel;
    OUT a, b;

    PARTS:
    // Put your code here:
    Nand(a=sel, b=sel, out=notsel); // sel not gate
    
    Nand(a=notsel, b=in, out=temp);
    Nand(a=temp, b=temp, out=a);

    Nand(a=sel, b=in, out=temp1);
    Nand(a=temp1, b=temp1, out=b);
} 
