// File name: projects/01/DMux8Way.hdl

/**
 * 8-way demultiplexor:
 * {a, b, c, d, e, f, g, h} = {in, 0, 0, 0, 0, 0, 0, 0} if sel == 000
 *                            {0, in, 0, 0, 0, 0, 0, 0} if sel == 001
 *                            etc.
 *                            {0, 0, 0, 0, 0, 0, 0, in} if sel == 111
 */

CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    // Put your code here:
    DMux(in=in,sel=sel[2],a=DMux11,b=DMux12);
    DMux4Way(in=DMux11,sel=sel[0..1],a=a,b=b,c=c,d=d);
    DMux4Way(in=DMux12,sel=sel[0..1],a=e,b=f,c=g,d=h);
    //這裡跟Mux8way使用了不一樣的方法，一個是使用了7個mux元件，
    //這裡則是使用了1個DMux加上2個DMux4Way元件
}