// File name: projects/01/DMux4Way.hdl

/**
 * 4-way demultiplexor:
 * {a, b, c, d} = {in, 0, 0, 0} if sel == 00
 *                {0, in, 0, 0} if sel == 01
 *                {0, 0, in, 0} if sel == 10
 *                {0, 0, 0, in} if sel == 11
 */

CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    // Put your code here:
    DMux(in=in,sel=sel[1],a=Dmux11,b=Dmux12); 
    DMux(in=Dmux11,sel=sel[0],a=a,b=b);
    DMux(in=Dmux12,sel=sel[0],a=c,b=d);
    //這裡注意要先使用高位元的sel[1]去區分[a,b]與[c,d]
    //然後在使用sel[0]去分a與b的差異 

}
