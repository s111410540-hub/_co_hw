// File name: projects/01/Mux.hdl

/** 
 * Multiplexor:
 * out = a if sel == 0
 *       b otherwise
 */

CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    // Put your code here:
    Nand(a=sel, b=sel, out=selnot); //sel not gate
    Nand(a=selnot, b=a, out=temp1); //s`a Nand
    Nand(a=sel,b=b, out=temp2); //s`b Nand
    Nand(a=temp1,b=temp2,out=out); 
}