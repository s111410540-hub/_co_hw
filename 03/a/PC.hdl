/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    PARTS:
    // Put your code here:
    // 算出目前值 + 1
    Inc16(in=current, out=plusOne);

    // inc=1：加一；inc=0：保持原值
    Mux16(a=current, b=plusOne, sel=inc, out=afterInc);

    // load=1：改用輸入 in，覆蓋 inc 的結果
    Mux16(a=afterInc, b=in, sel=load, out=afterLoad);

    // reset=1：改用 0，覆蓋前面的結果
    Mux16(a=afterLoad, b=false, sel=reset, out=next);

    // 儲存下一個值，同時輸出並回饋給前面的電路
    Register(in=next, load=true, out=current, out=out);

    //Mux16 的規則是：sel=0 選 a，sel=1 選 b。因此，越後面的 Mux 優先權越高，最後的 reset 可以覆蓋所有選擇。
}
