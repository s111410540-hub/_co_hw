/**
 * One round of Number Bomb.
 *
 * The bomb is somewhere in [low, high]. Each turn the current player
 * guesses a number in that range: if it is the bomb, that player loses;
 * otherwise the range shrinks to the side that still holds the bomb and
 * the other player takes a turn. Player 2 is either a second person or
 * the computer, which guesses at random within the range.
 */
class NumberBombGame {
    field int low, high;       // the bomb is somewhere in low..high
    field int bomb;            // the hidden number
    field int player;          // whose turn it is: 1 or 2
    field boolean vsComputer;  // true if player 2 is the computer
    field int lastGuess;       // the previous safe guess, 0 before the first one
    field int turns;           // number of guesses made so far

    /** Starts a round with a new random bomb. */
    constructor NumberBombGame new(boolean againstComputer) {
        let vsComputer = againstComputer;
        let low = 1;
        let high = 100;
        let bomb = Random.between(low, high);
        let player = 1;
        let lastGuess = 0;
        let turns = 0;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    /** Plays turns until someone hits the bomb, then shows the result. */
    method void run() {
        var int guess;
        var boolean exploded;

        while (~exploded) {
            do drawBoard();
            if (vsComputer & (player = 2)) {
                let guess = computerGuess();
            } else {
                let guess = humanGuess();
            }
            let turns = turns + 1;

            if (guess = bomb) {
                let exploded = true;
            } else {
                // keep only the side of the range that holds the bomb
                if (guess < bomb) {
                    let low = guess + 1;
                } else {
                    let high = guess - 1;
                }
                let lastGuess = guess;
                let player = 3 - player;   // 1 <-> 2
            }
        }

        do Ui.explode(256, 128);
        do showResult();
        return;
    }

    // ---------- turns ----------

    /** Asks the current (human) player for a guess until it is in range. */
    method int humanGuess() {
        var int guess;
        var boolean valid;

        do Ui.printAt(21, 1, "Type digits, BACKSPACE to delete, ENTER to confirm.");
        while (~valid) {
            do Ui.clearRow(13);
            do Ui.printAt(13, 1, "Your guess (");
            do printRange();
            do Ui.print("): ");
            let guess = NumberInput.read(3);

            let valid = (~(guess < low)) & (~(guess > high));
            if (~valid) {
                do Ui.clearRow(15);
                do Ui.printAt(15, 1, "Out of range! Pick a number from ");
                do printRange();
                do Ui.print(".");
            }
        }
        return guess;
    }

    /** The computer "thinks" for a moment, then guesses at random in range. */
    method int computerGuess() {
        var int guess, dots;

        do Ui.printAt(13, 1, "Computer is thinking");
        while (dots < 3) {
            do Sys.wait(300);
            do Ui.print(".");
            let dots = dots + 1;
        }
        let guess = Random.between(low, high);
        do Ui.print(" ");
        do Output.printInt(guess);
        do Sys.wait(700);
        return guess;
    }

    // ---------- drawing ----------

    /** Redraws the whole game screen for the current turn. */
    method void drawBoard() {
        do Screen.clearScreen();

        do Ui.printAt(0, 1, "NUMBER BOMB");
        if (vsComputer) {
            do Ui.printAt(0, 14, "(versus computer)");
        } else {
            do Ui.printAt(0, 14, "(two players)");
        }
        do Ui.drawBomb(480, 40, 14);

        do Output.moveCursor(2, 1);
        do printName(player);
        do Ui.print("'s turn");

        do Ui.printAt(4, 1, "Safe range: ");
        do printRange();
        do drawRangeBar();

        if (lastGuess > 0) {
            do Output.moveCursor(10, 1);
            do printName(3 - player);
            do Ui.print(" guessed ");
            do Output.printInt(lastGuess);
            if (lastGuess < low) {
                do Ui.print(" - the bomb is bigger.");
            } else {
                do Ui.print(" - the bomb is smaller.");
            }
        }
        if (low = high) {
            do Ui.printAt(11, 1, "Only one number is left...");
        }
        return;
    }

    /** Draws 1..100 as a bar, filling in the part where the bomb can still be.
     *  Number n occupies pixels x = 52+4n .. 55+4n (1 -> 56..59, 100 -> 452..455). */
    method void drawRangeBar() {
        do Screen.setColor(true);
        do Screen.drawLine(54, 64, 457, 64);
        do Screen.drawLine(54, 82, 457, 82);
        do Screen.drawLine(54, 64, 54, 82);
        do Screen.drawLine(457, 64, 457, 82);
        do Screen.drawRectangle(52 + (4 * low), 67, 55 + (4 * high), 79);

        do Ui.printAt(8, 7, "1");
        do Ui.printAt(8, 55, "100");
        return;
    }

    /** Shows who hit the bomb and who won. */
    method void showResult() {
        do Screen.clearScreen();
        do Ui.printAt(2, 29, "BOOM!");

        do Output.moveCursor(4, 12);
        do printName(player);
        do Ui.print(" hit the bomb! It was ");
        do Output.printInt(bomb);
        do Ui.print(".");

        do Output.moveCursor(6, 12);
        do printName(3 - player);
        do Ui.print(" wins after ");
        do Output.printInt(turns);
        do Ui.print(" guesses.");

        do Ui.drawBurst(256, 140);
        return;
    }

    // ---------- text helpers ----------

    /** Prints "low-high". */
    method void printRange() {
        do Output.printInt(low);
        do Ui.print("-");
        do Output.printInt(high);
        return;
    }

    /** Prints the name of player p (1 or 2). */
    method void printName(int p) {
        if (p = 1) {
            do Ui.print("Player 1");
        } else {
            if (vsComputer) {
                do Ui.print("Computer");
            } else {
                do Ui.print("Player 2");
            }
        }
        return;
    }
}
