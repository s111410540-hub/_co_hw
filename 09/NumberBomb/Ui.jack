/**
 * Screen and keyboard helpers shared by the whole game: text output,
 * key reading, the title / end screens, and the bomb graphics.
 *
 * Screen: 512 x 256 pixels. Text: 23 rows x 64 columns, each character
 * cell is 8 x 11 pixels, so text row r covers pixels r*11 .. r*11+10.
 */
class Ui {

    // ---------- text ----------

    /** Prints s and frees it. Every string literal allocates a new String,
     *  so printing literals in a loop without dispose() would leak memory. */
    function void print(String s) {
        do Output.printString(s);
        do s.dispose();
        return;
    }

    /** Prints s (and frees it) starting at the given text row and column. */
    function void printAt(int row, int col, String s) {
        do Output.moveCursor(row, col);
        do Ui.print(s);
        return;
    }

    /** Erases one text row. */
    function void clearRow(int row) {
        do Screen.setColor(false);
        do Screen.drawRectangle(0, row * 11, 511, (row * 11) + 10);
        return;
    }

    // ---------- keyboard ----------

    /** Waits until a key is pressed and released, and returns its code.
     *  Advances the random seed while waiting. */
    function int waitKey() {
        var int key;
        while (key = 0) {
            let key = Keyboard.keyPressed();
            do Random.tick();
        }
        while (~(Keyboard.keyPressed() = 0)) {
            do Random.tick();
        }
        return key;
    }

    // ---------- screens ----------

    /** Shows the title screen and waits for the mode.
     *  Returns true for "versus computer", false for "two players". */
    function boolean titleScreen() {
        var int key;

        do Screen.clearScreen();
        do Ui.printAt(2, 26, "NUMBER BOMB");
        do Ui.printAt(4, 10, "A bomb is hidden somewhere between 1 and 100.");
        do Ui.printAt(5, 10, "Take turns guessing; each guess shrinks the range.");
        do Ui.printAt(6, 10, "Whoever hits the bomb loses!");
        do Ui.drawBomb(256, 150, 30);
        do Ui.printAt(19, 12, "1 = Two players     2 = Versus computer");
        do Ui.printAt(21, 21, "Press 1 or 2 to start");

        // '1' = 49, '2' = 50
        while (~((key = 49) | (key = 50))) {
            let key = Ui.waitKey();
        }
        return key = 50;
    }

    /** Asks for a rematch. Returns true on ENTER, false on Q. */
    function boolean askPlayAgain() {
        var int key;

        do Ui.printAt(20, 12, "Press ENTER to play again, or Q to quit.");
        // ENTER = 128, 'Q' = 81, 'q' = 113
        while (~((key = 128) | (key = 81) | (key = 113))) {
            let key = Ui.waitKey();
        }
        return key = 128;
    }

    function void goodbye() {
        do Screen.clearScreen();
        do Ui.printAt(11, 22, "Thanks for playing!");
        return;
    }

    // ---------- graphics ----------

    /** Draws a bomb with a lit fuse; (x, y) is the centre of its body.
     *  Needs y - r - 19 >= 0 to stay on screen. */
    function void drawBomb(int x, int y, int r) {
        var int sx, sy;

        do Screen.setColor(true);
        do Screen.drawCircle(x, y, r);                                  // body
        do Screen.drawRectangle(x - 5, (y - r) - 6, x + 5, (y - r) + 2); // cap
        do Screen.drawLine(x, (y - r) - 6, x + 8, (y - r) - 14);        // fuse

        // spark at the end of the fuse
        let sx = x + 10;
        let sy = (y - r) - 16;
        do Screen.drawLine(sx - 3, sy, sx + 3, sy);
        do Screen.drawLine(sx, sy - 3, sx, sy + 3);
        do Screen.drawLine(sx - 2, sy - 2, sx + 2, sy + 2);
        do Screen.drawLine(sx - 2, sy + 2, sx + 2, sy - 2);

        // shine on the body
        do Screen.setColor(false);
        do Screen.drawCircle(x - (r / 3), y - (r / 3), r / 5);
        return;
    }

    /** Explosion animation centred at (x, y): a black blast grows out,
     *  then a white shock wave wipes it away. Needs 106 pixels of room. */
    function void explode(int x, int y) {
        var int r;

        do Screen.setColor(true);
        let r = 4;
        while (r < 110) {
            do Screen.drawCircle(x, y, r);
            do Sys.wait(20);
            let r = r + 6;
        }

        do Screen.setColor(false);
        let r = 4;
        while (r < 110) {
            do Screen.drawCircle(x, y, r);
            do Sys.wait(20);
            let r = r + 6;
        }
        return;
    }

    /** Draws a star-shaped burst (the bomb after it went off) at (x, y).
     *  Needs 60 pixels of room left/right and 40 above/below. */
    function void drawBurst(int x, int y) {
        do Screen.setColor(true);
        do Screen.drawLine(x - 60, y, x + 60, y);
        do Screen.drawLine(x, y - 40, x, y + 40);
        do Screen.drawLine(x - 45, y - 30, x + 45, y + 30);
        do Screen.drawLine(x - 45, y + 30, x + 45, y - 30);
        do Screen.drawLine(x - 25, y - 38, x + 25, y + 38);
        do Screen.drawLine(x - 25, y + 38, x + 25, y - 38);
        do Screen.drawCircle(x, y, 14);
        do Screen.setColor(false);
        do Screen.drawCircle(x, y, 6);
        return;
    }
}
